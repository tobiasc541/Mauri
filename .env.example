# Solo para el servidor de Next.js / Vercel: NUNCA usar NEXT_PUBLIC_ con la clave secreta.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_TU_CLAVE_SECRETA
# Secreto privado aleatorio para pseudonimizar la IP al limitar envíos.
IP_HASH_SECRET=reemplazar-por-un-secreto-aleatorio-largo-y-privado

# Acceso sin contraseña al administrador: enlace privado https://TU-DOMINIO/acceso?token=ESTE_VALOR
# Generar una cadena aleatoria larga con 32 bytes en hexadecimal. Nunca poner en NEXT_PUBLIC_.
ADMIN_ACCESS_TOKEN=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
